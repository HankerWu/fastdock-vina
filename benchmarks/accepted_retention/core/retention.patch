diff --git a/src/lib/trajectory_archive.h b/src/lib/trajectory_archive.h
index b875230..92a9fcd 100644
--- a/src/lib/trajectory_archive.h
+++ b/src/lib/trajectory_archive.h
@@ -7,7 +7,23 @@
 // This object owns only recorded evidence. It never mutates the search model,
 // writes to the historical output container, evaluates energy or advances RNG.
 struct trajectory_archive {
-	output_container accepted;
+    fl deferred_radius = -1;
+    boost::optional<output_type> deferred;
+    sz skipped = 0, geometry_checks = 0, records = 0;
+
+    void observe_skipped(const model& m, const output_type& pose, const output_container& saved) {
+        ++skipped;
+        if (!std::isfinite(pose.e) || (deferred && pose.e >= deferred->e)) return;
+        auto coords = m.get_heavy_atom_movable_coords();
+        ++geometry_checks;
+        const fl distance = find_closest(coords, saved).second;
+        if (distance == 0 || distance < deferred_radius) return;
+        deferred.emplace(pose.c, pose.e);
+        deferred->coords.swap(coords);
+        ++records;
+    }
+
+    output_container accepted;
 	std::vector<vecv> samples;
 	sz native_evaluations = 0;
 	sz native_refinements = 0;
