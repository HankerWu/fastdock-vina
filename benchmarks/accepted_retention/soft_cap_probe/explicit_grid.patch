+// Diagnostic-only read-through view of the native search and explicit receptors.
+#pragma once
+#include "non_cache.h"
+
+struct cap_grid_view : igrid {
+    const igrid& grid;
+    const non_cache& atomic;
+    cap_grid_view(const igrid& g, const non_cache& a) : grid(g), atomic(a) {}
+    fl eval(const model& m, fl v) const override { return grid.eval(m, v); }
+    fl eval_intra(model& m, fl v) const override { return grid.eval_intra(m, v); }
+    fl eval_deriv(model& m, fl v) const override { return grid.eval_deriv(m, v); }
+};
