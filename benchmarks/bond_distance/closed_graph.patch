+// Reconstruct cut edges solely for counting covalent separation. The kinematic
+// tree, atom typing and the two directed dummy-carbon restraints stay separate.
+static szv closure_partners(const atomv& atoms) {
+	std::array<szv, 4> endpoints;
+	VINA_FOR_IN(i, atoms) {
+		const sz type = atoms[i].ad;
+		if (type >= AD_TYPE_CG0 && type <= AD_TYPE_CG3)
+			endpoints[type - AD_TYPE_CG0].push_back(i);
+	}
+	szv partner;
+	for (const auto& ends : endpoints) {
+		if (ends.size() != 2) continue;
+		if (partner.empty()) partner.assign(atoms.size(), atoms.size());
+		partner[ends[0]] = ends[1];
+		partner[ends[1]] = ends[0];
+	}
+	return partner;
+}
+
+static szv closed_neighborhood(const atomv& atoms, const szv& partner, sz origin) {
+	szv queue{origin};
+	sz start = 0;
+	for (sz depth = 0; depth < 3; ++depth) {
+		const sz end = queue.size();
+		for (; start < end; ++start) {
+			const sz i = queue[start];
+			for (const auto& bond : atoms[i].bonds) {
+				const auto& b = bond.connected_atom_index;
+				if (!b.in_grid && !ad_is_closure_dummy(atoms[b.i].ad) && !has(queue, b.i))
+					queue.push_back(b.i);
+			}
+			if (partner[i] < atoms.size() && !has(queue, partner[i]))
+				queue.push_back(partner[i]);
+		}
+	}
+	return queue;
+}
