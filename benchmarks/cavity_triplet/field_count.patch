+// Observer for single-worker research runs. Count actual interpolation entries,
+// including scalar-only calls which are outside the optimizer counters.
+namespace {
+struct field_counts {
+    unsigned long long positions[2][2] = {};
+    ~field_counts() {
+        for (unsigned combined = 0; combined < 2; ++combined)
+            for (unsigned derivative = 0; derivative < 2; ++derivative)
+                std::fprintf(stderr, "FIELD_COUNT combined=%u derivative=%u positions=%llu\n",
+                             combined, derivative, positions[combined][derivative]);
+    }
+};
+field_counts observed_fields;
+}
