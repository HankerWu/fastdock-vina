+namespace {
+// PDBQT parsing stores the immobile axis endpoint in the parent frame.
+struct torsion_partition {
+    szv silent, other;
+
+    void visit(const branches& nodes, const model& m, sz& index) {
+        for (const auto& b : nodes) {
+            bool only_hydrogens = b.children.empty();
+            for (sz i = b.node.begin; only_hydrogens && i < b.node.end; ++i)
+                only_hydrogens = m.get_atom(i).is_hydrogen();
+            (only_hydrogens ? silent : other).push_back(index++);
+            visit(b.children, m, index);
+        }
+    }
+
+    bool redistribute(const conf& source, conf& proposal, bool enabled, sz& offered) const {
+        const auto& original = source.ligands.front().torsions;
+        auto& angles = proposal.ligands.front().torsions;
+        for (sz index : silent) {
+            if (angles[index] == original[index]) continue;
+            ++offered;
+            if (!enabled || other.empty()) return false;
+            // Decode the original uniform draw into a rotor and a uniform angle.
+            // The upper-end clamp also handles floating point rounding near pi.
+            const fl scaled = (angles[index] + pi) * (fl(other.size()) / (2*pi));
+            const sz k = (std::min)(sz(scaled), other.size() - 1);
+            angles[other[k]] = (2*pi) * (scaled - fl(k)) - pi;
+            angles[index] = original[index];
+            return true;
+        }
+        return false;
+    }
+};
