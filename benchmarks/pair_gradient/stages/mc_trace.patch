@@ -0,0 +1,59 @@
+// Research replay of a single trajectory; no scoring, RNG or live model writes.
+#ifndef FASTDOCK_DIAGNOSTIC_MC_TRACE_H
+#define FASTDOCK_DIAGNOSTIC_MC_TRACE_H
+
+#include "parse_pdbqt.h"
+#include <iostream>
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+
+inline void capture_hunt(const conf& c, const char* path) {
+    VINA_CHECK(c.ligands.size() == 1 && c.flex.empty());
+    const auto& ligand = c.ligands.front();
+    const auto& q = ligand.rigid.orientation;
+    std::ofstream f(path);
+    f << std::setprecision(17) << ligand.torsions.size();
+    for (sz i = 0; i < 3; ++i) f << ' ' << ligand.rigid.position[i];
+    f << ' ' << q.R_component_1() << ' ' << q.R_component_2()
+      << ' ' << q.R_component_3() << ' ' << q.R_component_4();
+    for (fl t : ligand.torsions) f << ' ' << t;
+    f << '\n';
+    f.close();
+    VINA_CHECK(f.good());
+}
+
+inline void restore_hunt(conf& c, const char* path) {
+    VINA_CHECK(c.ligands.size() == 1 && c.flex.empty());
+    auto& ligand = c.ligands.front();
+    std::ifstream f(path);
+    sz n;
+    VINA_CHECK(f >> n && n == ligand.torsions.size());
+    for (sz i = 0; i < 3; ++i) f >> ligand.rigid.position[i];
+    fl a, b, x, y;
+    VINA_CHECK(f >> a >> b >> x >> y);
+    ligand.rigid.orientation = qt(a, b, x, y);
+    for (fl& t : ligand.torsions) VINA_CHECK(f >> t);
+    std::string extra;
+    VINA_CHECK(!(f >> extra));
+}
+
+class diagnostic_mc_trace {
+    model snapshot;
+    std::map<unsigned, sz> indices;
+public:
+    explicit diagnostic_mc_trace(const model& original)
+        : snapshot(original), indices(ligand_heavy_indices_by_serial(snapshot)) {}
+    void emit(const char* stage, sz index, const conf& c) {
+        snapshot.set(c);
+        std::ostringstream out;
+        out << "FDTRACE " << stage << ' ' << index << std::setprecision(17);
+        for (const auto& kv : indices) {
+            const vec& p = snapshot.movable_coords(kv.second);
+            out << ' ' << kv.first << ',' << p[0] << ',' << p[1] << ',' << p[2];
+        }
+        std::cerr << out.str() << '\n';
+    }
+};
+#endif
