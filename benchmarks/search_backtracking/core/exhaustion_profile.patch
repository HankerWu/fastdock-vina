+			const fl probe_energy = f(probe, probe_gradient);
+			if (i) log << ',';
+			log << probe_energy - f0;
+			probe_step *= 0.5;
+		}
+		f(x_new, probe_gradient);
+		log << '\n';
+		std::cout << log.str();
+	}
