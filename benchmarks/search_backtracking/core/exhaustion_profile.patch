@@ -29,6 +29,8 @@
 
 #include "conf.h"
 #include <cstring>
+#include <iomanip>
+#include <sstream>
 
 // Only the local BFGS inverse Hessian uses this full symmetric storage.
 class flmat {
@@ -140,6 +142,27 @@ fl line_search(F& f, const conf& x, fl f0, const flv& p, fl pg, conf& x_new, flv
 			       ? quadratic_contraction(alpha, pg, f1 - f0) : multiplier;
 	}
 	if (monitor) ++monitor->exhausted;
+	if (monitor && monitor->mode == backtracking_mode::native) {
+		// Diagnostic-only replay: the native return value and iteration count
+		// still refer to the tenth rejected trial. Restore the model's cache.
+		conf probe = x_new;
+		flv probe_gradient = g_new;
+		std::ostringstream log;
+		log << std::setprecision(17) << "Exhausted line " << monitor->searches
